+
+impl NdiSinkCombiner {
+    /// Low latency: the video frame goes out as soon as it is here, carrying every audio
+    /// buffer already queued (audio that arrives later goes with the next frame). NDI
+    /// receivers place each audio frame by its own timecode.
+    fn aggregate_low_latency(&self) -> Result<gst::FlowSuccess, gst::FlowError> {
+        let video_buffer = match self.video_pad.peek_buffer() {
+            Some(buffer) => buffer,
+            None if !self.video_pad.is_eos() => return Err(gst_base::AGGREGATOR_FLOW_NEED_DATA),
+            None => return Err(gst::FlowError::Eos),
+        };
+        self.video_pad.drop_buffer();
+
+        // The queued audio is read WITHOUT the state lock: peek_buffer() can call into
+        // clip(), which takes the state lock again (same rule as aggregate()).
+        let mut queued = Vec::new();
+        if let Some(audio_pad) = self.audio_pad.lock().unwrap().clone() {
+            while let Some(audio_buffer) = audio_pad.peek_buffer() {
+                audio_pad.drop_buffer();
+                if audio_buffer.size() == 0 {
+                    continue;
+                }
+                if let Ok(segment) = audio_pad.segment().downcast::<gst::ClockTime>() {
+                    let running_time = segment.to_running_time(audio_buffer.pts());
+                    queued.push((audio_buffer, running_time));
+                }
+            }
+        }
+
+        let base_time = self.obj().base_time();
+        let (audio_buffers, pending_caps, pending_segment) = {
+            let mut state_storage = self.state.lock().unwrap();
+            let state = match &mut *state_storage {
+                Some(ref mut state) => state,
+                None => return Err(gst::FlowError::Flushing),
+            };
+            // anything held from normal mode goes out with this frame
+            let mut audio_buffers = mem::take(&mut state.current_audio_buffers);
+            state.current_video_buffer = None;
+            if let Some(audio_info) = state.audio_info.clone() {
+                for (audio_buffer, running_time) in queued {
+                    let timecode = base_time
+                        .zip(running_time)
+                        .map(|(base_time, running_time)| {
+                            ((base_time.nseconds() + running_time.nseconds()) / 100) as i64
+                        })
+                        .unwrap_or(crate::ndisys::NDIlib_send_timecode_synthesize);
+                    audio_buffers.push((audio_buffer, audio_info.clone(), timecode));
+                }
+            }
+            (audio_buffers, state.pending_caps.take(), state.pending_segment.take())
+        };
+
+        let mut video_buffer = video_buffer;
+        if !audio_buffers.is_empty() {
+            crate::ndisinkmeta::NdiSinkAudioMeta::add(video_buffer.make_mut(), audio_buffers);
+        }
+        if let Some(caps) = pending_caps {
+            self.obj().set_src_caps(&caps);
+        }
+        if let Some(segment) = pending_segment {
+            self.obj().update_segment(&segment);
+        }
+        self.obj().finish_buffer(video_buffer)
     }
