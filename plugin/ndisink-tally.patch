+
+    /// Tally that the connected receivers report for this sender (program / preview).
+    pub fn tally(&self, timeout_ms: u32) -> Tally {
+        let mut tally = NDIlib_tally_t {
+            on_program: false,
+            on_preview: false,
+        };
+        unsafe {
+            NDIlib_send_get_tally(self.0.as_ptr(), &mut tally, timeout_ms);
+        }
+        Tally(tally)
+    }
+
+    /// Number of receivers currently connected to this sender.
+    pub fn connections(&self, timeout_ms: u32) -> i32 {
+        unsafe { NDIlib_send_get_no_connections(self.0.as_ptr(), timeout_ms) }
+    }
 }
 
