<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- NDIICAM: anuncia el panel web en la red local -->
<service-group>
  <name replace-wildcards="yes">NDIICAM %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
  </service>
</service-group>
